{
  "specVersion": 1,
  "description": "Parameters of the named algorithms (SPEC.md sections 4 to 8).",
  "ruleIds": {
    "keyContext": "key-context",
    "sizeLimit": "size-limit",
    "depthLimit": "depth-limit",
    "circular": "circular",
    "failed": "redaction-failed",
    "error": "error"
  },
  "text": {
    "minScanLength": 8
  },
  "placeholder": {
    "open": "[REDACTED:",
    "close": "]",
    "stripPrefixes": [
      "@secretlint/secretlint-rule-",
      "mobilerun-redaction/"
    ]
  },
  "evidence": {
    "quoteChars": "'\"",
    "classes": [
      "[a-z]",
      "[A-Z]",
      "[0-9]",
      "[^A-Za-z0-9]"
    ],
    "minClasses": 3,
    "entropyThreshold": 3.4
  },
  "trivial": {
    "words": [
      "undefined",
      "null",
      "changeme",
      "example",
      "placeholder",
      "password",
      "secret",
      "token"
    ],
    "maskChars": [
      "x",
      "*"
    ],
    "wrappers": [
      [
        "<",
        ">"
      ],
      [
        "{",
        "}"
      ]
    ],
    "wrapperInner": "[^\n\r\u2028\u2029]"
  },
  "docPlaceholder": {
    "prefixes": [
      "your",
      "my",
      "the",
      "replace",
      "insert",
      "example",
      "dummy",
      "sample"
    ],
    "suffixes": [
      "here"
    ],
    "separator": "[_-]"
  },
  "sync": {
    "maxChars": 4000000,
    "maxDepth": 64,
    "maxNodes": 500000,
    "maxKeyChars": 4096
  },
  "full": {
    "scanWindow": 100000,
    "scanOverlap": 10240,
    "scanCap": 2000000
  },
  "strict": {
    "maxChars": 4000000,
    "maxDepth": 64,
    "maxNodes": 500000
  }
}
