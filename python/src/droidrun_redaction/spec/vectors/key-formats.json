{
  "description": "known credential formats found by shape, with no keyword",
  "cases": [
    {
      "name": "jwt",
      "input": "token is eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJVadQssw5c ok",
      "expected": "token is [REDACTED:jwt] ok"
    },
    {
      "name": "jwt as bearer",
      "input": "Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJVadQssw5c",
      "expected": "Authorization: Bearer [REDACTED:jwt]"
    },
    {
      "name": "google api key",
      "input": "ref AIzaSyA1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q done",
      "expected": "ref [REDACTED:gcp-api-key] done"
    },
    {
      "name": "xai api key",
      "input": "xai-Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1Ab1ab",
      "expected": "[REDACTED:xai-api-key]"
    },
    {
      "name": "github token",
      "input": "my github token is ghp_16C7e42F292c6912E7710c838347Ae178B4a",
      "expected": "my github token is [REDACTED:github]"
    },
    {
      "name": "aws access key id",
      "input": "creds: AKIAQR7ZKT4MW2PLX9BD",
      "expected": "creds: [REDACTED:aws]"
    },
    {
      "name": "slack token",
      "input": "hook xoxb-1234567890-abcdefghijkl",
      "expected": "hook [REDACTED:slack]"
    },
    {
      "name": "platform token srt1",
      "input": "run srt1.3fa85f64-5717-4562-b3fc-2c963f66afa6.17.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA done",
      "expected": "run [REDACTED:platform-token] done"
    },
    {
      "name": "platform token srt2 with another kind word",
      "input": "run srt2.3fa85f64-5717-4562-b3fc-2c963f66afa6.9b2e1c7a-0d44-4e8b-a1f3-6c5d7e8f9a0b.runner.1731900000.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef done",
      "expected": "run [REDACTED:platform-token] done"
    },
    {
      "name": "platform token srt2 with the longest kind word (16 letters)",
      "input": "srt2.3fa85f64-5717-4562-b3fc-2c963f66afa6.9b2e1c7a-0d44-4e8b-a1f3-6c5d7e8f9a0b.aaaaaaaaaaaaaaaa.42.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "expected": "[REDACTED:platform-token]"
    },
    {
      "name": "guard: srt2 kind word of 17 letters is not a platform token",
      "input": "ref srt2.3fa85f64-5717-4562-b3fc-2c963f66afa6.9b2e1c7a-0d44-4e8b-a1f3-6c5d7e8f9a0b.aaaaaaaaaaaaaaaaa.42.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef end",
      "expected": "ref srt2.3fa85f64-5717-4562-b3fc-2c963f66afa6.9b2e1c7a-0d44-4e8b-a1f3-6c5d7e8f9a0b.aaaaaaaaaaaaaaaaa.42.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef end"
    },
    {
      "name": "guard: srt2 kind word with a digit is not a platform token",
      "input": "ref srt2.3fa85f64-5717-4562-b3fc-2c963f66afa6.9b2e1c7a-0d44-4e8b-a1f3-6c5d7e8f9a0b.run2.42.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef end",
      "expected": "ref srt2.3fa85f64-5717-4562-b3fc-2c963f66afa6.9b2e1c7a-0d44-4e8b-a1f3-6c5d7e8f9a0b.run2.42.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef end"
    },
    {
      "name": "guard: decoy google key, 34-char body",
      "input": "legacyId=AIzaS_f0sYnC4Rce_xcEmtOikZcYypDAJ7fS00",
      "expected": "legacyId=AIzaS_f0sYnC4Rce_xcEmtOikZcYypDAJ7fS00"
    },
    {
      "name": "guard: bare xai- prefix as a name",
      "input": "the xai-labs team renamed the xai-eval-harness repo",
      "expected": "the xai-labs team renamed the xai-eval-harness repo"
    },
    {
      "name": "url userinfo",
      "input": "postgres://admin:hunter2secret@db.example.com:5432/app",
      "expectedSync": "postgres://admin:[REDACTED:url-credentials]@db.example.com:5432/app",
      "expectedAsync": "[REDACTED:database-connection-string]"
    },
    {
      "name": "https userinfo",
      "input": "GET https://user:p%40ss@example.test/path",
      "expected": "GET https://user:[REDACTED:url-credentials]@example.test/path"
    },
    {
      "name": "guard: userinfo without a password",
      "input": "git clone https://user@example.test/repo.git",
      "expected": "git clone https://user@example.test/repo.git"
    },
    {
      "name": "pem private key",
      "input": "-----BEGIN RSA PRIVATE KEY-----\nMIIBOgIBAAJBAKj34GkxFhD90vcNLYLInFEX6Ppy1tPf9Cnzj4p4WGeKLs1Pt8Qu\n-----END RSA PRIVATE KEY----- after",
      "expected": "[REDACTED:private-key] after"
    },
    {
      "name": "pem private key with literal backslash-n",
      "input": "{\"key\":\"-----BEGIN PRIVATE KEY-----\\nMIIBOgIBAAJBAKj34GkxFhD90vcNLYLInFEX6Ppy1tPf9Cnzj4p4WGeKLs1Pt8Qu\\n-----END PRIVATE KEY-----\\n\",\"x\":1}",
      "expected": "{\"key\":\"[REDACTED:private-key]\\n\",\"x\":1}"
    },
    {
      "name": "pem without footer",
      "input": "cut: -----BEGIN PRIVATE KEY-----\nMIIBOgIBAAJBAKj34GkxFhD90vcNLYLInFEX6Ppy1tPf9Cn",
      "expected": "cut: [REDACTED:private-key]"
    },
    {
      "name": "platform key",
      "input": "key dr_sk_abcdef1234567890abcdef used",
      "expected": "key [REDACTED:platform-key] used"
    },
    {
      "name": "openai style keys",
      "input": "sk-proj-abcdefghij1234567890ABCDEFGH and sk-ant-api03-abcdefghij1234567890ABCDEFGH",
      "expected": "[REDACTED:openai] and [REDACTED:openai]"
    },
    {
      "name": "stripe keys",
      "input": "sk_live_abcdefghijklmnop1234 rk_test_abcdefghijklmnop1234",
      "expected": "[REDACTED:stripe] [REDACTED:stripe]"
    },
    {
      "name": "guard: sk- package name",
      "input": "see sk-learn-is-a-name-of-package here",
      "expected": "see sk-learn-is-a-name-of-package here"
    },
    {
      "name": "strict: platform key with a short body",
      "input": "key dr_sk_first used",
      "mode": "strict",
      "expected": "key [REDACTED:platform-key] used"
    },
    {
      "name": "strict: platform key with a hyphen",
      "input": "key dr_sk_abc-def used",
      "mode": "strict",
      "expected": "key [REDACTED:platform-key] used"
    },
    {
      "name": "strict: platform key in upper case",
      "input": "key DR_SK_abcdefghijklmnopqrstuvwxyz used",
      "mode": "strict",
      "expected": "key [REDACTED:platform-key] used"
    },
    {
      "name": "strict: the platform key prefix alone is prose",
      "input": "the dr_sk_ prefix marks a key",
      "mode": "strict",
      "expected": "the dr_sk_ prefix marks a key"
    },
    {
      "name": "strict: a text shorter than eight units is scanned for a platform key",
      "input": "dr_sk_a",
      "mode": "strict",
      "expected": "[REDACTED:platform-key]"
    },
    {
      "name": "strict: platform key after an escaped line break",
      "input": "{\"msg\":\"key:\\ndr_sk_abcdefgh12345678\"}",
      "mode": "strict",
      "expected": "{\"msg\":\"key:\\n[REDACTED:platform-key]\"}"
    },
    {
      "name": "strict: platform key after an escaped tab",
      "input": "line1\\tdr_sk_abcdefgh12345678",
      "mode": "strict",
      "expected": "line1\\t[REDACTED:platform-key]"
    },
    {
      "name": "strict: platform key between percent-encoded quotes",
      "input": "%22dr_sk_abcdefgh12345678%22",
      "mode": "strict",
      "expected": "%22[REDACTED:platform-key]%22"
    },
    {
      "name": "strict: platform key after a word and an underscore",
      "input": "x_dr_sk_abcdefgh12345678",
      "mode": "strict",
      "expected": "x_[REDACTED:platform-key]"
    }
  ]
}
