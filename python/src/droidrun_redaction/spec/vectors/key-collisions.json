{
  "description": "Object keys that collide after replacement (SPEC 8, L-P and L-Q, decided by Lutz 2026-11-18), standard tier: no value is lost. A key that redaction leaves as it is keeps its own name (also a key written as a placeholder); of the changed keys the first keeps its key, the next ones get `#2`, `#3` inside their last placeholder. `pending` marks a file that Python and Go skip until they implement it (the TypeScript package runs it).",
  "pending": "L-P",
  "cases": [
    {
      "name": "keys that collide after replacement keep every value: #2 and #3 inside the placeholder",
      "input": {
        "first": 1,
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "a",
        "ghp_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "b",
        "ghp_cccccccccccccccccccccccccccccccccccc": "c"
      },
      "expected": {
        "first": 1,
        "[REDACTED:github]": "a",
        "[REDACTED:github#2]": "b",
        "[REDACTED:github#3]": "c"
      }
    },
    {
      "name": "collisions are counted per object and per placeholder key",
      "input": {
        "x": {
          "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1,
          "ghp_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": 2
        },
        "ghp_cccccccccccccccccccccccccccccccccccc": 3,
        "ghp_dddddddddddddddddddddddddddddddddddd": 4
      },
      "expected": {
        "x": {
          "[REDACTED:github]": 1,
          "[REDACTED:github#2]": 2
        },
        "[REDACTED:github]": 3,
        "[REDACTED:github#2]": 4
      }
    },
    {
      "name": "a key written as a placeholder keeps its own name, also when a secret key comes first",
      "input": {
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1,
        "[REDACTED:github]": 2
      },
      "expected": {
        "[REDACTED:github#2]": 1,
        "[REDACTED:github]": 2
      }
    },
    {
      "name": "a key written as a placeholder keeps its own name when it comes first",
      "input": {
        "[REDACTED:github]": 1,
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 2
      },
      "expected": {
        "[REDACTED:github]": 1,
        "[REDACTED:github#2]": 2
      }
    },
    {
      "name": "a key written as a numbered placeholder is reserved: the generated numbers skip it",
      "input": {
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1,
        "ghp_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": 2,
        "[REDACTED:github#2]": 3
      },
      "expected": {
        "[REDACTED:github]": 1,
        "[REDACTED:github#3]": 2,
        "[REDACTED:github#2]": 3
      }
    },
    {
      "name": "a key written as a numbered placeholder is not numbered again",
      "input": {
        "[REDACTED:github#2]": 1,
        "[REDACTED:github]": 2,
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 3
      },
      "expected": {
        "[REDACTED:github#2]": 1,
        "[REDACTED:github]": 2,
        "[REDACTED:github#3]": 3
      }
    },
    {
      "name": "a key that holds a replaced part gets the number inside its last placeholder",
      "input": {
        "password=Zq9MuIT1yZAN2BE75_x": 1,
        "password=Zq9SUNzC6gKF6pN5U_x": 2,
        "password=Zq9YblSwUbRt0MaKi_x": 3
      },
      "expected": {
        "password=[REDACTED:generic-keyword]": "[REDACTED:key-context]",
        "password=[REDACTED:generic-keyword#2]": "[REDACTED:key-context]",
        "password=[REDACTED:generic-keyword#3]": "[REDACTED:key-context]"
      }
    },
    {
      "name": "a key with text after the placeholder is numbered inside the placeholder",
      "input": {
        "token ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa end": 1,
        "token ghp_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb end": 2
      },
      "expected": {
        "token [REDACTED:github] end": "[REDACTED:key-context]",
        "token [REDACTED:github#2] end": "[REDACTED:key-context]"
      }
    },
    {
      "name": "strict: keys that collide after replacement keep every value",
      "input": {
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "a",
        "ghp_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "b"
      },
      "mode": "strict",
      "expected": {
        "[REDACTED:github]": "a",
        "[REDACTED:github#2]": "b"
      }
    },
    {
      "name": "strict: a key written as a placeholder keeps its own name",
      "input": {
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1,
        "[REDACTED:github]": 2
      },
      "mode": "strict",
      "expected": {
        "[REDACTED:github#2]": 1,
        "[REDACTED:github]": 2
      }
    },
    {
      "name": "strict: partly replaced keys are numbered",
      "input": {
        "password=Zq9MuIT1yZAN2BE75_x": 1,
        "password=Zq9SUNzC6gKF6pN5U_x": 2
      },
      "mode": "strict",
      "expected": {
        "password=[REDACTED:generic-keyword]": "[REDACTED:key-context]",
        "password=[REDACTED:generic-keyword#2]": "[REDACTED:key-context]"
      }
    },
    {
      "name": "node limit: the entry written as it was does not replace an earlier one",
      "input": {
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "keep-me",
        "[REDACTED:github]": 2
      },
      "opts": {
        "maxNodes": 2
      },
      "expectedSync": {
        "[REDACTED:github#2]": "keep-me",
        "[REDACTED:github]": "[REDACTED:size-limit]"
      },
      "expectedAsync": {
        "[REDACTED:github#2]": "keep-me",
        "[REDACTED:github]": 2
      }
    },
    {
      "name": "strict: the collapsed rest takes a free numbered key",
      "input": {
        "[REDACTED:size-limit]": 1,
        "b": 2,
        "c": 3
      },
      "mode": "strict",
      "opts": {
        "maxNodes": 3
      },
      "expected": {
        "[REDACTED:size-limit]": 1,
        "b": 2,
        "[REDACTED:size-limit#2]": "[REDACTED:size-limit]"
      }
    }
  ]
}
