{
  "description": "Bearer, Basic and Token authorization values",
  "cases": [
    {
      "name": "bearer header",
      "input": "Authorization: Bearer abc.def-1=",
      "expected": "Authorization: Bearer [REDACTED:auth-header]"
    },
    {
      "name": "bearer lower case",
      "input": "authorization: bearer abc.def-1= for the call",
      "expected": "authorization: bearer [REDACTED:auth-header] for the call"
    },
    {
      "name": "bearer in a sentence",
      "input": "sent x Bearer zzz y",
      "expected": "sent x Bearer [REDACTED:auth-header] y"
    },
    {
      "name": "basic credentials",
      "input": "Authorization: Basic dXNlcjpwYXNzd29yZA==",
      "expected": "Authorization: Basic [REDACTED:auth-header]"
    },
    {
      "name": "basic lower case",
      "input": "basic dXNlcjpwYXNz",
      "expected": "basic [REDACTED:auth-header]"
    },
    {
      "name": "token scheme",
      "input": "Authorization: Token 9f8e7d6c5b4a3210",
      "expected": "Authorization: Token [REDACTED:auth-header]"
    },
    {
      "name": "proxy authorization header in a json value",
      "input": {
        "Proxy-Authorization": "Basic dXNlcjpwYXNzd29yZA==",
        "accept": "json"
      },
      "expected": {
        "Proxy-Authorization": "[REDACTED:key-context]",
        "accept": "json"
      }
    },
    {
      "name": "header map",
      "input": {
        "headers": {
          "X-Forwarded": "Bearer abc.def-ghi",
          "accept": "json"
        }
      },
      "expected": {
        "headers": {
          "X-Forwarded": "Bearer [REDACTED:auth-header]",
          "accept": "json"
        }
      }
    },
    {
      "name": "prose with Token",
      "input": "Token expired, Basic information, token refresh",
      "expected": "Token expired, Basic information, token refresh"
    },
    {
      "name": "prose with Basic",
      "input": "Basic Authentication",
      "expected": "Basic Authentication"
    },
    {
      "name": "prose with token",
      "input": "use the token",
      "expected": "use the token"
    },
    {
      "name": "cookie header line",
      "input": "Cookie: sid=abc123; theme=dark; other=1",
      "expected": "Cookie: [REDACTED:cookie]"
    },
    {
      "name": "set-cookie header line",
      "input": "Set-Cookie: session=xyz; Path=/; HttpOnly\nHost: example.test",
      "expected": "Set-Cookie: [REDACTED:cookie]\nHost: example.test"
    },
    {
      "name": "guard: Cookie without a pair",
      "input": "Cookie: enabled",
      "expected": "Cookie: enabled"
    },
    {
      "name": "guard: missing bearer prose",
      "input": "Missing or invalid bearer token",
      "expected": "Missing or invalid bearer token"
    },
    {
      "name": "guard: bearer scheme prose",
      "input": "Use the Bearer scheme in the Authorization header",
      "expected": "Use the Bearer scheme in the Authorization header"
    },
    {
      "name": "cookie value stops at escaped upper-case N",
      "input": "Cookie: a=b\\Nxyz tail",
      "expected": "Cookie: [REDACTED:cookie]\\Nxyz tail"
    },
    {
      "name": "cookie value stops at escaped upper-case R",
      "input": "Cookie: a=b\\Rxyz tail",
      "expected": "Cookie: [REDACTED:cookie]\\Rxyz tail"
    },
    {
      "name": "cookie value stops at escaped lower-case n",
      "input": "Set-Cookie: sid=Zq9abcDEF123ghi\\nxyz",
      "expected": "Set-Cookie: [REDACTED:cookie]\\nxyz"
    },
    {
      "name": "cookie value continues past another escape",
      "input": "Cookie: a=b\\Xxyz tail",
      "expected": "Cookie: [REDACTED:cookie]"
    },
    {
      "name": "strict: bearer credential with a punctuation mark",
      "input": "Bearer abc!defghijklmnop",
      "mode": "strict",
      "expected": "Bearer [REDACTED:auth-header]"
    },
    {
      "name": "strict: bearer credential with a colon",
      "input": "Bearer foo:barbazquux",
      "mode": "strict",
      "expected": "Bearer [REDACTED:auth-header]"
    },
    {
      "name": "strict: bearer credential ends at a quote",
      "input": "curl -H \"Authorization: Bearer abc!defghij\" url",
      "mode": "strict",
      "expected": "curl -H \"Authorization: Bearer [REDACTED:auth-header]\" url"
    },
    {
      "name": "strict: bearer credential in escaped json ends at the escaped quote",
      "input": "{\\\"hdr\\\":\\\"Bearer abc!defghij\\\"}",
      "mode": "strict",
      "expected": "{\\\"hdr\\\":\\\"Bearer [REDACTED:auth-header]\\\"}"
    },
    {
      "name": "strict: bearer credential in quotes",
      "input": "Authorization: Bearer \"abcdef\"",
      "mode": "strict",
      "expected": "Authorization: Bearer \"[REDACTED:auth-header]\""
    },
    {
      "name": "strict: a second bearer inside the first credential is still found",
      "input": "Bearer user:abcdefgh&Bearer pwd=null, x",
      "mode": "strict",
      "expected": "Bearer [REDACTED:auth-header] [REDACTED:auth-header], x"
    },
    {"name": "feedback: Bearer abc;def", "input": "Bearer abc;def", "mode": "strict", "opts": {"pii": true}, "expected": "Bearer [REDACTED:auth-header]"},
    {"name": "feedback: Bearer abc,def", "input": "Bearer abc,def", "mode": "strict", "opts": {"pii": true}, "expected": "Bearer [REDACTED:auth-header]"},
    {"name": "feedback: Bearer \"abc;def tail\"", "input": "Bearer \"abc;def tail\"", "mode": "strict", "opts": {"pii": true}, "expected": "Bearer \"[REDACTED:auth-header]\""},
    {"name": "feedback: Authorization: ApiKey hunter2", "input": "Authorization: ApiKey hunter2", "mode": "strict", "opts": {"pii": true}, "expected": "Authorization: [REDACTED:auth-header]"},
    {"name": "feedback: Authorization: Basic eDp5", "input": "Authorization: Basic eDp5", "mode": "strict", "opts": {"pii": true}, "expected": "Authorization: [REDACTED:auth-header]"},
    {"name": "feedback: HTTP_AUTHORIZATION: Digest username=alice, response=sample_digest", "input": "HTTP_AUTHORIZATION: Digest username=alice, response=sample_digest", "mode": "strict", "opts": {"pii": true}, "expected": "HTTP_AUTHORIZATION: [REDACTED:auth-header]"},
    {"name": "feedback: Proxy-Authorization: Custom hunter2", "input": "Proxy-Authorization: Custom hunter2", "mode": "strict", "opts": {"pii": true}, "expected": "Proxy-Authorization: [REDACTED:auth-header]"},
    {"name": "feedback: Bearer tokens, are rejected", "input": "Bearer tokens, are rejected", "mode": "strict", "opts": {"pii": true}, "expected": "Bearer tokens, are rejected"},
    {"name": "feedback: complete prefixed Basic header, not the next line", "input": "X-Authorization: Basic dXNlcjpwYXNz\r\nnext", "mode": "strict", "opts": {"pii": true}, "expected": "X-Authorization: [REDACTED:auth-header]\r\nnext"},
    {"name": "review: token punctuation", "input": "Authorization: Acme.v2+v1 hunter2", "mode": "strict", "opts": {"pii": true}, "expected": "Authorization: [REDACTED:auth-header]"},
    {"name": "review: label boundary", "input": "preauthorization: payment was declined", "mode": "strict", "opts": {"pii": true}, "expected": "preauthorization: payment was declined"},
    {"name": "review: punctuation does not hide the next Bearer credential", "input": "Bearer abc;Bearer second!secret", "mode": "strict", "opts": {"pii": true}, "expected": "Bearer [REDACTED:auth-header] [REDACTED:auth-header]"},
    {"name": "review: punctuation does not hide the next quoted Bearer credential", "input": "Bearer abc;Bearer \"ab!private\"", "mode": "strict", "opts": {"pii": true}, "expected": "Bearer [REDACTED:auth-header] \"[REDACTED:auth-header]\""},
    {"name": "review: a punctuated Bearer header still uses credential-level redaction", "input": "Authorization: Bearer abc;Bearer \"ab!private\"", "mode": "strict", "opts": {"pii": true}, "expected": "Authorization: Bearer [REDACTED:auth-header] \"[REDACTED:auth-header]\""},
    {"name": "review: single-quoted Authorization does not consume the next field", "input": "{'Authorization': 'Basic abc', 'other': 'visible'}", "mode": "strict", "opts": {"pii": true}, "expected": "{'Authorization': '[REDACTED:auth-header]', 'other': 'visible'}"},
    {"name": "review: double-quoted Authorization does not consume the next field", "input": "{\"Authorization\": \"Basic abc\", \"other\": \"visible\"}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"Authorization\": \"[REDACTED:auth-header]\", \"other\": \"visible\"}"},
    {"name": "review: a placeholder argument exempts the Basic header", "input": "Authorization: Basic [REDACTED:x]", "mode": "strict", "opts": {"pii": true}, "expected": "Authorization: Basic [REDACTED:x]"},
    {"name": "compat: no short Basic authorization scan", "input": "Authorization: Basic eDp5", "mode": "compat", "opts": {"pii": true}, "expected": "Authorization: Basic eDp5"}
  ]
}
