{
  "description": "secrets in URL query strings and URLs in free text",
  "cases": [
    {
      "name": "token query parameter",
      "input": "GET https://example.test/cb?token=abc123&x=1",
      "expected": "GET https://example.test/cb?token=[REDACTED:key-context]&x=1"
    },
    {
      "name": "api key after ampersand",
      "input": "https://example.test/v1?x=1&api_key=Zk9fake&y=2",
      "expected": "https://example.test/v1?x=1&api_key=[REDACTED:generic-keyword]&y=2"
    },
    {
      "name": "signature parameter",
      "input": "https://files.example.test/o?sig=AbCdEf123&expires=99",
      "expected": "https://files.example.test/o?sig=[REDACTED:key-context]&expires=99"
    },
    {
      "name": "encoded key name",
      "input": "https://example.test/?access%5Ftoken=abc&z=1",
      "expected": "https://example.test/?access%5Ftoken=[REDACTED:key-context]&z=1"
    },
    {
      "name": "placeholder already in query (idempotent)",
      "input": "https://example.test/?token=[REDACTED:key-context]&x=1",
      "expected": "https://example.test/?token=[REDACTED:key-context]&x=1"
    },
    {
      "name": "guard: ordinary parameters",
      "input": "see https://example.com/path?query=abcdefgh123&page=2 for docs",
      "expected": "see https://example.com/path?query=abcdefgh123&page=2 for docs"
    },
    {
      "name": "guard: author parameter",
      "input": "https://example.test/?author=bob&tokenizer=bpe",
      "expected": "https://example.test/?author=bob&tokenizer=bpe"
    },
    {
      "name": "nested url unencoded",
      "input": "https://x.test/cb?redirect=https://y.test/?token=abc123&z=1",
      "expected": "https://x.test/cb?redirect=https://y.test/?token=[REDACTED:key-context]&z=1"
    },
    {
      "name": "nested url percent-encoded",
      "input": "https://x.test/cb?redirect=https%3A%2F%2Fy.test%2F%3Ftoken%3Dabc123&z=1",
      "expected": "https://x.test/cb?redirect=[REDACTED:key-context]&z=1"
    },
    {
      "name": "oauth code in a query",
      "input": "https://x.test/cb?code=4%2F0AbCdEf&state=1",
      "expected": "https://x.test/cb?code=[REDACTED:key-context]&state=1"
    },
    {
      "name": "guard: code is an ordinary json key",
      "input": {
        "code": "ABC123",
        "status": "ok"
      },
      "expected": {
        "code": "ABC123",
        "status": "ok"
      }
    },
    {
      "name": "long secret value in a query",
      "input": "https://x.test/?&x=1",
      "expected": "https://x.test/?token=[REDACTED:key-context]&x=1"
    }
  ]
}
