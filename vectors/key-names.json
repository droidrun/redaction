{
  "description": "values under secret-named object keys, whatever their type",
  "cases": [
    {
      "name": "camelCase and snake_case keys",
      "input": {
        "apiKey": "abc",
        "client_secret": "def",
        "url": "https://example.test"
      },
      "expected": {
        "apiKey": "[REDACTED:key-context]",
        "client_secret": "[REDACTED:key-context]",
        "url": "https://example.test"
      }
    },
    {
      "name": "header names",
      "input": {
        "headers": {
          "X-Api-Key": "k-1",
          "x-auth-token": "t",
          "Set-Cookie": "sid=1",
          "accept": "json"
        }
      },
      "expected": {
        "headers": {
          "X-Api-Key": "[REDACTED:key-context]",
          "x-auth-token": "[REDACTED:key-context]",
          "Set-Cookie": "[REDACTED:key-context]",
          "accept": "json"
        }
      }
    },
    {
      "name": "nested objects and arrays",
      "input": {
        "body": {
          "user": {
            "password": "hunter2",
            "profile": {
              "apiKey": "abc"
            }
          }
        },
        "list": [
          {
            "accessToken": "t"
          },
          {
            "authToken": "t2"
          }
        ]
      },
      "expected": {
        "body": {
          "user": {
            "password": "[REDACTED:key-context]",
            "profile": {
              "apiKey": "[REDACTED:key-context]"
            }
          }
        },
        "list": [
          {
            "accessToken": "[REDACTED:key-context]"
          },
          {
            "authToken": "[REDACTED:key-context]"
          }
        ]
      }
    },
    {
      "name": "object value under a secret key is replaced as a unit",
      "input": {
        "client_secret": {
          "id": 1,
          "value": "x"
        },
        "keep": 1
      },
      "expected": {
        "client_secret": {
          "id": 1,
          "value": "[REDACTED:key-context]"
        },
        "keep": 1
      }
    },
    {
      "name": "array value under a secret key is replaced as a unit",
      "input": {
        "tokens": [
          "a",
          "b"
        ]
      },
      "expected": {
        "tokens": [
          "[REDACTED:key-context]",
          "[REDACTED:key-context]"
        ]
      }
    },
    {
      "name": "number under a secret key",
      "input": {
        "pin": 1234,
        "name": "card"
      },
      "expected": {
        "pin": "[REDACTED:key-context]",
        "name": "card"
      }
    },
    {
      "name": "exact short names",
      "input": {
        "pwd": "a",
        "otp": "123456",
        "totp": "x",
        "cvv": "123",
        "cvc": "456",
        "name": "n"
      },
      "expected": {
        "pwd": "[REDACTED:key-context]",
        "otp": "[REDACTED:key-context]",
        "totp": "[REDACTED:key-context]",
        "cvv": "[REDACTED:key-context]",
        "cvc": "[REDACTED:key-context]",
        "name": "n"
      }
    },
    {
      "name": "boolean and null under a secret key stay",
      "input": {
        "hasPassword": true,
        "password": null,
        "token": false
      },
      "expected": {
        "hasPassword": true,
        "password": null,
        "token": false
      }
    },
    {
      "name": "empty string under a secret key stays",
      "input": {
        "password": "",
        "name": "n"
      },
      "expected": {
        "password": "",
        "name": "n"
      }
    },
    {
      "name": "placeholder under a secret key stays (idempotent)",
      "input": {
        "password": "[REDACTED:key-context]"
      },
      "expected": {
        "password": "[REDACTED:key-context]"
      }
    },
    {
      "name": "legacy placeholder under a secret key stays",
      "input": {
        "password": "[REDACTED]"
      },
      "expected": {
        "password": "[REDACTED]"
      }
    },
    {
      "name": "structural keys type and id are never touched",
      "input": {
        "type": "password",
        "id": "token",
        "password": "x"
      },
      "expected": {
        "type": "password",
        "id": "token",
        "password": "[REDACTED:key-context]"
      }
    },
    {
      "name": "guard: secretary",
      "input": {
        "secretary": "Jane Doe"
      },
      "expected": {
        "secretary": "Jane Doe"
      }
    },
    {
      "name": "guard: passwordless",
      "input": {
        "passwordless": "enabled",
        "passwordlessLogin": "on"
      },
      "expected": {
        "passwordless": "enabled",
        "passwordlessLogin": "on"
      }
    },
    {
      "name": "guard: tokenizer",
      "input": {
        "tokenizer": "bpe",
        "cookbook": "pasta",
        "author": "me",
        "authority": "x"
      },
      "expected": {
        "tokenizer": "bpe",
        "cookbook": "pasta",
        "author": "me",
        "authority": "x"
      }
    },
    {
      "name": "guard: pinned",
      "input": {
        "pinned": "yes",
        "spin": "right",
        "options": "a"
      },
      "expected": {
        "pinned": "yes",
        "spin": "right",
        "options": "a"
      }
    },
    {
      "name": "token counts stay numbers",
      "input": {
        "tokens": [
          1,
          2,
          3
        ],
        "max_tokens": 100,
        "prompt_tokens": 12,
        "token_count": 7
      },
      "expected": {
        "tokens": [
          1,
          2,
          3
        ],
        "max_tokens": 100,
        "prompt_tokens": 12,
        "token_count": 7
      }
    },
    {
      "name": "usage object stays",
      "input": {
        "usage": {
          "prompt_tokens": 3,
          "completion_tokens": 4,
          "total_tokens": 7
        }
      },
      "expected": {
        "usage": {
          "prompt_tokens": 3,
          "completion_tokens": 4,
          "total_tokens": 7
        }
      }
    },
    {
      "name": "strings under a plural key are replaced",
      "input": {
        "tokens": [
          "a",
          "b"
        ]
      },
      "expected": {
        "tokens": [
          "[REDACTED:key-context]",
          "[REDACTED:key-context]"
        ]
      }
    },
    {
      "name": "container under a secret key is walked, strings replaced",
      "input": {
        "client_secret": {
          "id": 1,
          "value": "x",
          "n": 5
        }
      },
      "expected": {
        "client_secret": {
          "id": 1,
          "value": "[REDACTED:key-context]",
          "n": "[REDACTED:key-context]"
        }
      }
    },
    {
      "name": "numeric secret under a singular key",
      "input": {
        "token": 12345,
        "password": 20240101,
        "pin": 1234
      },
      "expected": {
        "token": "[REDACTED:key-context]",
        "password": "[REDACTED:key-context]",
        "pin": "[REDACTED:key-context]"
      }
    },
    {
      "name": "pwd suffix",
      "input": {
        "MYSQL_PWD": "a",
        "dbPwd": "b",
        "adminpwd": "c",
        "pwd": "d",
        "cwd": "/home"
      },
      "expected": {
        "MYSQL_PWD": "[REDACTED:key-context]",
        "dbPwd": "[REDACTED:key-context]",
        "adminpwd": "[REDACTED:key-context]",
        "pwd": "[REDACTED:key-context]",
        "cwd": "/home"
      }
    },
    {
      "name": "compound lower-case names",
      "input": {
        "secretkey": "a",
        "accesskeyid": "b",
        "privatekeypem": "c",
        "apikeyvalue": "d"
      },
      "expected": {
        "secretkey": "[REDACTED:key-context]",
        "accesskeyid": "[REDACTED:key-context]",
        "privatekeypem": "[REDACTED:key-context]",
        "apikeyvalue": "[REDACTED:key-context]"
      }
    },
    {
      "name": "more secret names",
      "input": {
        "pass": "a",
        "auth": "b",
        "basicAuth": "c",
        "privKey": "d",
        "signingKey": "e",
        "encryptionKey": "f",
        "masterKey": "g",
        "sshKey": "h",
        "serviceAccountKey": "i",
        "dsn": "j",
        "connectionString": "k",
        "recoveryCodes": [
          "l"
        ]
      },
      "expected": {
        "pass": "[REDACTED:key-context]",
        "auth": "[REDACTED:key-context]",
        "basicAuth": "[REDACTED:key-context]",
        "privKey": "[REDACTED:key-context]",
        "signingKey": "[REDACTED:key-context]",
        "encryptionKey": "[REDACTED:key-context]",
        "masterKey": "[REDACTED:key-context]",
        "sshKey": "[REDACTED:key-context]",
        "serviceAccountKey": "[REDACTED:key-context]",
        "dsn": "[REDACTED:key-context]",
        "connectionString": "[REDACTED:key-context]",
        "recoveryCodes": [
          "[REDACTED:key-context]"
        ]
      }
    },
    {
      "name": "guard: sid is an ordinary id",
      "input": {
        "sid": "AC1234567890",
        "callSid": "CA123"
      },
      "expected": {
        "sid": "AC1234567890",
        "callSid": "CA123"
      }
    },
    {
      "name": "guard: passThrough and bypass",
      "input": {
        "passThrough": "x",
        "bypass": "y",
        "passenger": "z"
      },
      "expected": {
        "passThrough": "x",
        "bypass": "y",
        "passenger": "z"
      }
    },
    {
      "name": "0.1.1 matched keys still match",
      "input": {
        "AWS_SECRET_ACCESS_KEY": "a",
        "accessKeyId": "b",
        "secretKeyBase": "c",
        "GITHUB_TOKEN": "d",
        "DB_PASSWD": "e",
        "api_keys": "f",
        "user_credentials": "g",
        "session_token_id": "h"
      },
      "expected": {
        "AWS_SECRET_ACCESS_KEY": "[REDACTED:key-context]",
        "accessKeyId": "[REDACTED:key-context]",
        "secretKeyBase": "[REDACTED:key-context]",
        "GITHUB_TOKEN": "[REDACTED:key-context]",
        "DB_PASSWD": "[REDACTED:key-context]",
        "api_keys": "[REDACTED:key-context]",
        "user_credentials": "[REDACTED:key-context]",
        "session_token_id": "[REDACTED:key-context]"
      }
    },
    {
      "name": "structural keys skip primitives only",
      "input": {
        "type": {
          "password": "hunter2"
        },
        "id": "password=hunter2abcd"
      },
      "expected": {
        "type": {
          "password": "[REDACTED:key-context]"
        },
        "id": "password=hunter2abcd"
      }
    },
    {
      "name": "secret in an object key",
      "input": {
        "Bearer abc12345678": 1
      },
      "expected": {
        "Bearer [REDACTED:auth-header]": 1
      }
    }
  ]
}
