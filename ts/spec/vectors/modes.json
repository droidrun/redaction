{
  "description": "Failure modes and limits: compat and strict, text and JSON. `mode` and `opts` (maxChars, maxDepth, maxNodes) are passed to the entry point; `inputGen`/`expectedGenAsync` give a large string as repeated parts.",
  "cases": [
    {
      "name": "compat text over maxChars is replaced whole",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa password=Zq9abcDEF123ghi_x",
      "opts": {
        "maxChars": 10
      },
      "expectedSync": "[REDACTED:size-limit]",
      "expectedAsync": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa password=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict text over maxChars is replaced whole",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa password=Zq9abcDEF123ghi_x",
      "mode": "strict",
      "opts": {
        "maxChars": 10
      },
      "expected": "[REDACTED:size-limit]"
    },
    {
      "name": "compat json deeper than maxDepth",
      "input": {
        "a": {
          "b": {
            "c": "x"
          }
        }
      },
      "opts": {
        "maxDepth": 2
      },
      "expectedSync": {
        "a": {
          "b": "[REDACTED:depth-limit]"
        }
      },
      "expectedAsync": {
        "a": {
          "b": {
            "c": "x"
          }
        }
      }
    },
    {
      "name": "strict json deeper than maxDepth",
      "input": {
        "a": {
          "b": {
            "c": "x"
          }
        }
      },
      "mode": "strict",
      "opts": {
        "maxDepth": 2
      },
      "expected": {
        "a": {
          "b": "[REDACTED:depth-limit]"
        }
      }
    },
    {
      "name": "compat json array beyond maxNodes",
      "input": [
        1,
        2,
        3,
        4,
        5
      ],
      "opts": {
        "maxNodes": 3
      },
      "expectedSync": [
        1,
        2,
        "[REDACTED:size-limit]"
      ],
      "expectedAsync": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "name": "strict json array beyond maxNodes collapses the rest",
      "input": [
        1,
        2,
        3,
        4,
        5
      ],
      "mode": "strict",
      "opts": {
        "maxNodes": 3
      },
      "expected": [
        1,
        2,
        "[REDACTED:size-limit]"
      ]
    },
    {
      "name": "compat json object beyond maxNodes",
      "input": {
        "a": 1,
        "b": 2,
        "c": 3,
        "d": 4
      },
      "opts": {
        "maxNodes": 3
      },
      "expectedSync": {
        "a": 1,
        "b": 2,
        "c": "[REDACTED:size-limit]"
      },
      "expectedAsync": {
        "a": 1,
        "b": 2,
        "c": 3,
        "d": 4
      }
    },
    {
      "name": "strict json object beyond maxNodes collapses the rest under one marker key",
      "input": {
        "a": 1,
        "b": 2,
        "c": 3,
        "d": 4
      },
      "mode": "strict",
      "opts": {
        "maxNodes": 3
      },
      "expected": {
        "a": 1,
        "b": 2,
        "[REDACTED:size-limit]": "[REDACTED:size-limit]"
      }
    },
    {
      "name": "compat json leaf beyond maxChars is replaced whole",
      "input": {
        "a": "12345",
        "b": "password=Zq9abcDEF123ghi_x"
      },
      "opts": {
        "maxChars": 8
      },
      "expectedSync": {
        "a": "12345",
        "b": "[REDACTED:size-limit]"
      },
      "expectedAsync": {
        "a": "12345",
        "b": "password=[REDACTED:generic-keyword]"
      }
    },
    {
      "name": "strict json leaf beyond maxChars is replaced whole",
      "input": {
        "a": "12345",
        "b": "password=Zq9abcDEF123ghi_x"
      },
      "mode": "strict",
      "opts": {
        "maxChars": 8
      },
      "expected": {
        "a": "12345",
        "b": "[REDACTED:size-limit]"
      }
    },
    {
      "name": "strict json: a leaf that fits is scanned",
      "input": {
        "a": "12345",
        "b": "password=Zq9abcDEF123ghi_x"
      },
      "mode": "strict",
      "opts": {
        "maxChars": 40
      },
      "expected": {
        "a": "12345",
        "b": "password=[REDACTED:generic-keyword]"
      }
    },
    {
      "name": "strict json: an over-long key is replaced",
      "input": {
        "": "v"
      },
      "mode": "strict",
      "expected": {
        "[REDACTED:size-limit]": "[REDACTED:size-limit]"
      }
    },
    {
      "name": "strict json: a key of 4096 characters is scanned",
      "input": {
        "": "v"
      },
      "mode": "strict",
      "expected": {
        "": "v"
      }
    },
    {
      "name": "strict json: keys and values count against maxChars",
      "input": {
        "abcdefghij": "v",
        "b": "w"
      },
      "mode": "strict",
      "opts": {
        "maxChars": 12
      },
      "expected": {
        "abcdefghij": "v",
        "b": "[REDACTED:size-limit]"
      }
    },
    {
      "name": "strict json: a secret under a secret key is replaced at depth",
      "input": {
        "a": [
          {
            "password": "hunter2"
          }
        ]
      },
      "mode": "strict",
      "expected": {
        "a": [
          {
            "password": "[REDACTED:key-context]"
          }
        ]
      }
    },
    {
      "name": "strict text beyond the scan cap: the rest is replaced",
      "mode": "strict",
      "inputGen": {
        "parts": [
          [
            "ab ",
            666700
          ],
          [
            " tail password=Zq9abcDEF123ghi_x",
            1
          ]
        ]
      },
      "expectedGenAsync": {
        "parts": [
          [
            "ab ",
            666666
          ],
          [
            "ab",
            1
          ],
          [
            "[REDACTED:size-limit]",
            1
          ]
        ]
      },
      "expectedGenSync": {
        "parts": [
          [
            "ab ",
            666700
          ],
          [
            " tail password=[REDACTED:generic-keyword]",
            1
          ]
        ]
      }
    },
    {
      "name": "compat text beyond the scan cap: the sync rules still run, the rest is unscanned by the upstream scanners",
      "inputGen": {
        "parts": [
          [
            "ab ",
            666700
          ],
          [
            " tail password=Zq9abcDEF123ghi_x",
            1
          ]
        ]
      },
      "expectedGenAsync": {
        "parts": [
          [
            "ab ",
            666700
          ],
          [
            " tail password=[REDACTED:generic-keyword]",
            1
          ]
        ]
      },
      "expectedGenSync": {
        "parts": [
          [
            "ab ",
            666700
          ],
          [
            " tail password=[REDACTED:generic-keyword]",
            1
          ]
        ]
      }
    }
  ]
}
