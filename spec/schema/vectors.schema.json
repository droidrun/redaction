{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vector file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "input": {},
          "inputGen": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              }
            }
          },
          "mode": {
            "enum": [
              "compat",
              "strict"
            ]
          },
          "opts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxChars": {
                "type": "integer",
                "minimum": 0
              },
              "maxDepth": {
                "type": "integer",
                "minimum": 0
              },
              "maxNodes": {
                "type": "integer",
                "minimum": 0
              },
              "pii": {
                "type": "boolean"
              }
            }
          },
          "expected": {},
          "expectedSync": {},
          "expectedAsync": {},
          "expectedGenSync": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              }
            }
          },
          "expectedGenAsync": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "inputGen"
            ]
          }
        ]
      }
    },
    "tier": {
      "enum": [
        "full"
      ]
    },
    "pending": {
      "type": "string",
      "minLength": 1
    }
  }
}
