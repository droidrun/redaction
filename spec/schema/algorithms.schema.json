{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "algorithms.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "ruleIds",
    "text",
    "placeholder",
    "evidence",
    "trivial",
    "docPlaceholder",
    "sync",
    "full",
    "strict",
    "letters"
  ],
  "properties": {
    "specVersion": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "ruleIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyContext",
        "sizeLimit",
        "depthLimit",
        "circular",
        "failed",
        "error"
      ],
      "properties": {
        "keyContext": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "sizeLimit": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "depthLimit": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "circular": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "failed": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "error": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minScanLength"
      ],
      "properties": {
        "minScanLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open",
        "close",
        "stripPrefixes"
      ],
      "properties": {
        "open": {
          "type": "string",
          "minLength": 1
        },
        "close": {
          "type": "string",
          "minLength": 1
        },
        "stripPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quoteChars",
        "classes",
        "minClasses",
        "entropyThreshold"
      ],
      "properties": {
        "quoteChars": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "minClasses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "entropyThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "trivial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "words",
        "maskChars",
        "wrappers",
        "wrapperInner"
      ],
      "properties": {
        "words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "maskChars": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "wrappers": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "wrapperInner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "docPlaceholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefixes",
        "suffixes",
        "separator"
      ],
      "properties": {
        "prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "suffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "separator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxChars",
        "maxDepth",
        "maxNodes",
        "maxKeyChars"
      ],
      "properties": {
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maxKeyChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "full": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanWindow",
        "scanOverlap",
        "scanCap"
      ],
      "properties": {
        "scanWindow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "scanOverlap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "scanCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "strict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxChars",
        "maxDepth",
        "maxNodes"
      ],
      "properties": {
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "letters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicodeVersion",
        "ranges"
      ],
      "properties": {
        "unicodeVersion": {
          "const": "15.0.0"
        },
        "ranges": {
          "type": "string",
          "pattern": "^[0-9a-f]+(-[0-9a-f]+)?(,[0-9a-f]+(-[0-9a-f]+)?)*$"
        }
      }
    }
  }
}
