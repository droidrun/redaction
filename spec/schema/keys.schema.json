{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "keys.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "structuralSkipKeys",
    "secretWords",
    "extraSequences",
    "exactKeys",
    "joinedExtra",
    "suffixWords",
    "prefixWords",
    "passLastWord",
    "countWords"
  ],
  "properties": {
    "specVersion": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "structuralSkipKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "secretWords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z]+$"
        }
      }
    },
    "extraSequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z]+$"
        }
      }
    },
    "exactKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "joinedExtra": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "suffixWords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "prefixWords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "passLastWord": {
      "type": "string",
      "minLength": 1
    },
    "countWords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
