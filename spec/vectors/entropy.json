{
  "description": "Value evidence by entropy: two-class values just below and just above the 3.4 threshold (the same symbol counts in different first-seen order change the last digits of the sum), and values whose entropy divides by the UTF-16 length, not the number of code points.",
  "cases": [
    {
      "name": "entropy 3.3999767 (below by 2.3e-5)",
      "input": "token=aaaaaaabbbcccdddeeefffggghijklm",
      "expected": "token=aaaaaaabbbcccdddeeefffggghijklm"
    },
    {
      "name": "entropy 3.3999767 (below by 2.3e-5, other order of summation)",
      "input": "token=aaaaaaaaabbbbbbbcdefghijklmnopq",
      "expected": "token=aaaaaaaaabbbbbbbcdefghijklmnopq"
    },
    {
      "name": "entropy 3.3999233 (below by 7.7e-5)",
      "input": "token=aaaaaaaaaaaaaaabbbbbbbbbcdefghijklmnopqrstu",
      "expected": "token=aaaaaaaaaaaaaaabbbbbbbbbcdefghijklmnopqrstu"
    },
    {
      "name": "entropy 3.3998773 (below by 1.2e-4)",
      "input": "token=aaaaaaaaaaaaaaaabbbcccdddeefghijklmnopqrs",
      "expected": "token=aaaaaaaaaaaaaaaabbbcccdddeefghijklmnopqrs"
    },
    {
      "name": "entropy 3.4000104 (above by 1.0e-5)",
      "input": "token=aaaaaaaabbbbbbccccdddeefghijklmno",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "entropy 3.4000104 (above by 1.0e-5, other order of summation)",
      "input": "token=aaaaaaaabbbbbbcccddeeffgghhijklmn",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "entropy 3.4000104 (above by 1.0e-5, third order)",
      "input": "token=aaaaaaaabbbcccdddeeffgghhiijjkkll",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "entropy divides by UTF-16 length, 11 symbols in 13 units",
      "input": "token=abcdefghi😀🔑",
      "expected": "token=abcdefghi😀🔑"
    },
    {
      "name": "entropy divides by UTF-16 length, 13 symbols in 16 units",
      "input": "token=abcdefghij😀🔑🔑",
      "expected": "token=abcdefghij😀🔑🔑"
    }
  ]
}
