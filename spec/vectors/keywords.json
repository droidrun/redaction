{
  "description": "credential keywords followed by a value, in free text",
  "cases": [
    {
      "name": "bare password pair",
      "input": "password: hunter2",
      "expected": "password: [REDACTED:generic-keyword]"
    },
    {
      "name": "password with mixed value",
      "input": "login: admin password: S0mmer2026!xTr0ub4dor",
      "expected": "login: admin password: [REDACTED:generic-keyword]"
    },
    {
      "name": "equals form, trailing comma kept",
      "input": "api_key=sk-live-1,next=2",
      "expected": "api_key=[REDACTED:generic-keyword],next=2"
    },
    {
      "name": "quoted value with spaces",
      "input": "password=\"my secret phrase\" next",
      "expected": "password=\"[REDACTED:generic-keyword]\" next"
    },
    {
      "name": "single quoted value",
      "input": "password='my secret phrase' next",
      "expected": "password='[REDACTED:generic-keyword]' next"
    },
    {
      "name": "escaped quote inside value",
      "input": "password=\"she said \\\"hi there\\\" ok\" tail",
      "expected": "password=\"[REDACTED:generic-keyword]\" tail"
    },
    {
      "name": "unterminated quote",
      "input": "password=\"truncated-by-cut",
      "expected": "password=\"[REDACTED:generic-keyword]"
    },
    {
      "name": "json object text",
      "input": "{\"api_key\": \"has space, and comma\"}",
      "expected": "{\"api_key\": \"[REDACTED:generic-keyword]\"}"
    },
    {
      "name": "json object text with client_secret",
      "input": "{\"client_secret\":\"Zk9-fakeMARKER_7q2x\",\"ok\":true}",
      "expected": "{\"client_secret\":\"[REDACTED:generic-keyword]\",\"ok\":true}"
    },
    {
      "name": "prefixed identifier",
      "input": "session_token: Zk9-fakeMARKER_7q2x",
      "expected": "session_token: [REDACTED:generic-keyword]"
    },
    {
      "name": "two pairs in one line",
      "input": "user=bob password=hunter2 token=Zk9-fakeMARKER_7q2x",
      "expected": "user=bob password=[REDACTED:generic-keyword] token=[REDACTED:generic-keyword]"
    },
    {
      "name": "aws secret access key",
      "input": "AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMIK7MDENGbPxRfiCYzzzzKEY9xxx1",
      "expectedSync": "AWS_SECRET_ACCESS_KEY=[REDACTED:generic-keyword]",
      "expectedAsync": "AWS_SECRET_ACCESS_KEY=[REDACTED:aws]"
    },
    {
      "name": "already a placeholder (idempotent)",
      "input": "password: [REDACTED:generic-keyword]",
      "expected": "password: [REDACTED:generic-keyword]"
    },
    {
      "name": "legacy bare placeholder stays",
      "input": "password: [REDACTED]",
      "expected": "password: [REDACTED]"
    },
    {
      "name": "legacy last4 placeholder stays",
      "input": "password: [REDACTED:generic-keyword:4dor]",
      "expected": "password: [REDACTED:generic-keyword:4dor]"
    },
    {
      "name": "escaped json, one layer",
      "input": "{\\\"password\\\":\\\"hunter2abc\\\",\\\"ok\\\":1}",
      "expected": "{\\\"password\\\":\\\"[REDACTED:generic-keyword]\\\",\\\"ok\\\":1}"
    },
    {
      "name": "escaped json, two layers",
      "input": "{\\\\\\\"password\\\\\\\":\\\\\\\"hunter2abc\\\\\\\",\\\\\\\"ok\\\\\\\":1}",
      "expected": "{\\\\\\\"password\\\\\\\":\\\\\\\"[REDACTED:generic-keyword]\\\\\\\",\\\\\\\"ok\\\\\\\":1}"
    },
    {
      "name": "escaped json with spaces in the value",
      "input": "{\\\"api_key\\\":\\\"has space, here\\\",\\\"ok\\\":1}",
      "expected": "{\\\"api_key\\\":\\\"[REDACTED:generic-keyword]\\\",\\\"ok\\\":1}"
    },
    {
      "name": "secret longer than the capture window",
      "input": "password=Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1! tail",
      "expected": "password=[REDACTED:generic-keyword] tail"
    },
    {
      "name": "label inside a rejected value",
      "input": "password : session_token: Zq9fakeSECRET_8x",
      "expected": "password : [REDACTED:generic-keyword] [REDACTED:generic-keyword]"
    },
    {
      "name": "placeholder with a space in last4 stays",
      "input": "password: [REDACTED:generic-keyword:ab cd]",
      "expected": "password: [REDACTED:generic-keyword:ab cd]"
    },
    {
      "name": "value that merely starts like a placeholder",
      "input": "password=[REDACTED]tail1234",
      "expected": "password=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under password",
      "input": "password=x",
      "mode": "strict",
      "expected": "password=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under token",
      "input": "token=hunter2",
      "mode": "strict",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under client_secret",
      "input": "client_secret=abc123xyz",
      "mode": "strict",
      "expected": "client_secret=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under api_key",
      "input": "api_key=x",
      "mode": "strict",
      "expected": "api_key=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under DB_PASS",
      "input": "DB_PASS=hunter2",
      "mode": "strict",
      "expected": "DB_PASS=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under SECRET_KEY",
      "input": "SECRET_KEY=abc123",
      "mode": "strict",
      "expected": "SECRET_KEY=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under aws_secret_access_key",
      "input": "aws_secret_access_key=abc",
      "mode": "strict",
      "expected": "aws_secret_access_key=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value under signing_key",
      "input": "signing_key=abc",
      "mode": "strict",
      "expected": "signing_key=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: short value in json text",
      "input": "{\"password\":\"x\"}",
      "mode": "strict",
      "expected": "{\"password\":\"[REDACTED:generic-keyword]\"}"
    },
    {
      "name": "strict: a text shorter than eight units is scanned",
      "input": "token=x",
      "mode": "strict",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: escaped json in a quoted string",
      "input": "upstream body: \"{\\\"token\\\":\\\"hunter2\\\",\\\"otp\\\":\\\"482913\\\"}\"",
      "mode": "strict",
      "expected": "upstream body: \"{\\\"token\\\":\\\"[REDACTED:generic-keyword]\\\",\\\"otp\\\":\\\"[REDACTED:generic-keyword]\\\"}\""
    },
    {
      "name": "strict: arrow separator",
      "input": "password => \"hunter2\"",
      "mode": "strict",
      "expected": "password => \"[REDACTED:generic-keyword]\""
    },
    {
      "name": "strict: assignment separator",
      "input": "password := \"hunter2\"",
      "mode": "strict",
      "expected": "password := \"[REDACTED:generic-keyword]\""
    },
    {
      "name": "strict: arrow separator without spaces",
      "input": "token=>abc",
      "mode": "strict",
      "expected": "token=>[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: multiline quoted value is redacted through the closing quote",
      "input": "password=\"first\nhunter2\"",
      "mode": "strict",
      "expected": "password=\"[REDACTED:generic-keyword]\""
    },
    {
      "name": "strict: an unterminated quote fails closed, also on a kept word",
      "input": "password=\"Bearer",
      "mode": "strict",
      "expected": "password=\"[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: number under a count key is kept, text under it is not",
      "input": "max_tokens: 5 and max_tokens: five",
      "mode": "strict",
      "expected": "max_tokens: 5 and max_tokens: [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: status word in capitals is kept",
      "input": "TOKEN: EXPIRED and auth: Failed",
      "mode": "strict",
      "expected": "TOKEN: EXPIRED and auth: Failed"
    },
    {
      "name": "strict: a status word under a key the quoted pair rule knows is redacted",
      "input": "password: required",
      "mode": "strict",
      "expected": "password: [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: invalid under password is redacted",
      "input": "password=invalid",
      "mode": "strict",
      "expected": "password=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: false under secret is redacted",
      "input": "secret=false",
      "mode": "strict",
      "expected": "secret=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a scheme word under password is redacted",
      "input": "password=Bearer",
      "mode": "strict",
      "expected": "password=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a scheme word under Authorization is kept for the auth header rule",
      "input": "Authorization: Bearer abc12345",
      "mode": "strict",
      "expected": "Authorization: Bearer [REDACTED:auth-header]"
    },
    {
      "name": "strict: pair after a key without a verdict",
      "input": "user=bob note=password=hunter2",
      "mode": "strict",
      "expected": "user=bob note=password=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a lone mask character is a value, a run of them is a stand-in",
      "input": "password=* and secret=****",
      "mode": "strict",
      "expected": "password=[REDACTED:generic-keyword] and secret=****"
    },
    {
      "name": "strict: a kept value of 64 units stays",
      "input": "token=your_api_key_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_here",
      "mode": "strict",
      "expected": "token=your_api_key_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_here"
    },
    {
      "name": "strict: a doc placeholder longer than 64 units is redacted",
      "input": "token=your_api_key_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_here",
      "mode": "strict",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a key hidden in a parent value is still found, yaml",
      "input": "secrets:\n  api_key: sk-live-abc",
      "mode": "strict",
      "expected": "secrets:\n  api_key: [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a value never starts after a line break",
      "input": "auth:\n  password: hunter2\n  user: bob",
      "mode": "strict",
      "expected": "auth:\n  password: [REDACTED:generic-keyword]\n  user: bob"
    },
    {
      "name": "strict: a pair inside the value of a pair, same line",
      "input": "auth: password: hunter2",
      "mode": "strict",
      "expected": "auth: [REDACTED:generic-keyword] [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a quoted pair inside the value of a pair",
      "input": "token: password:\"hunter2 with spaces\"",
      "mode": "strict",
      "expected": "token: [REDACTED:generic-keyword]\"[REDACTED:generic-keyword]\""
    },
    {
      "name": "strict: an escaped quoted pair inside a cookie value",
      "input": "Cookie: secret=\\\"abc\\\" rest",
      "mode": "strict",
      "expected": "Cookie: [REDACTED:cookie]\\\"[REDACTED:generic-keyword]\\\" rest"
    },
    {
      "name": "strict: otp key with an inner pair",
      "input": "otp: api_key: hunter22",
      "mode": "strict",
      "expected": "otp: [REDACTED:generic-keyword] [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: an inner pair only the new rule knows, same line",
      "input": "auth: token: hunter2",
      "mode": "strict",
      "expected": "auth: [REDACTED:generic-keyword] [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: an inner pair only the new rule knows, yaml",
      "input": "auth:\n  token: hunter2",
      "mode": "strict",
      "expected": "auth:\n  token: [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a scheme word under a key that is not an authorization key is redacted",
      "input": "token=Bearer",
      "mode": "strict",
      "expected": "token=[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: an unterminated quote fails closed on a scheme word too",
      "input": "token=\"Bearer",
      "mode": "strict",
      "expected": "token=\"[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: an unterminated quote fails closed on a status word",
      "input": "token=\"expired",
      "mode": "strict",
      "expected": "token=\"[REDACTED:generic-keyword]"
    },
    {
      "name": "strict: a scheme word under an authorization key is kept for the auth header rule",
      "input": "Authorization=Basic",
      "mode": "strict",
      "expected": "Authorization=Basic"
    },
    {
      "name": "strict: pin key with an inner pair",
      "input": "pin: password: hunter2",
      "mode": "strict",
      "expected": "pin: [REDACTED:generic-keyword] [REDACTED:generic-keyword]"
    },
    {
      "name": "strict: json key shorter than eight units is scanned",
      "input": {
        "token=x": "v"
      },
      "mode": "strict",
      "expected": {
        "token=[REDACTED:generic-keyword]": "[REDACTED:key-context]"
      }
    },
    {
      "name": "strict: json key that holds a secret is scanned",
      "input": {
        "token=hunter2": 1
      },
      "mode": "strict",
      "expected": {
        "token=[REDACTED:generic-keyword]": "[REDACTED:key-context]"
      }
    },
    {
      "name": "strict worst case: 190 kept-looking pairs in one run",
      "inputGen": {
        "parts": [
          [
            "your_token=",
            190
          ]
        ]
      },
      "mode": "strict",
      "expectedGenSync": {
        "parts": [
          [
            "your_token=[REDACTED:generic-keyword]",
            1
          ]
        ]
      },
      "expectedGenAsync": {
        "parts": [
          [
            "your_token=[REDACTED:generic-keyword]",
            1
          ]
        ]
      }
    },
    {
      "name": "strict worst case: 180 quoted kept-looking pairs, the last quote is open",
      "inputGen": {
        "parts": [
          [
            "your_token=\"",
            180
          ]
        ]
      },
      "mode": "strict",
      "expectedGenSync": {
        "parts": [
          [
            "your_token=\"",
            180
          ]
        ]
      },
      "expectedGenAsync": {
        "parts": [
          [
            "your_token=\"",
            180
          ]
        ]
      }
    },
    {"name": "feedback: token=Basic hunter2", "input": "token=Basic hunter2", "mode": "strict", "opts": {"pii": true}, "expected": "token=[REDACTED:secret]"},
    {"name": "feedback: token: Token abc123", "input": "token: Token abc123", "mode": "strict", "opts": {"pii": true}, "expected": "token: [REDACTED:secret]"},
    {"name": "known gap: DB_PASSWORD: correct horse battery staple", "input": "DB_PASSWORD: correct horse battery staple", "mode": "strict", "opts": {"pii": true}, "expected": "DB_PASSWORD: [REDACTED:generic-keyword] horse battery staple"},
    {"name": "known gap: password: 'it''s secret'", "input": "password: 'it''s secret'", "mode": "strict", "opts": {"pii": true}, "expected": "password: '[REDACTED:generic-keyword]''s secret'"},
    {"name": "known gap: {\"token\": {\"value\": \"hunter2\"}}", "input": "{\"token\": {\"value\": \"hunter2\"}}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"token\": [REDACTED:generic-keyword]\"value\": \"hunter2\"}}"},
    {"name": "known gap: token := {\"value\": \"hunter2\"}", "input": "token := {\"value\": \"hunter2\"}", "mode": "strict", "opts": {"pii": true}, "expected": "token := [REDACTED:generic-keyword]\"value\": \"hunter2\"}"},
    {"name": "known gap: token => {\"value\": \"hunter2\"}", "input": "token => {\"value\": \"hunter2\"}", "mode": "strict", "opts": {"pii": true}, "expected": "token => [REDACTED:generic-keyword]\"value\": \"hunter2\"}"},
    {"name": "known gap: {\"token\":\\n {\"value\": \"hunter2\"}}", "input": "{\"token\":\n {\"value\": \"hunter2\"}}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"token\":\n {\"value\": \"hunter2\"}}"},
    {"name": "known gap: password=[x,hunter2] tail", "input": "password=[x,hunter2] tail", "mode": "strict", "opts": {"pii": true}, "expected": "password=[REDACTED:generic-keyword],hunter2] tail"},
    {"name": "feedback: {\"token\":[REDACTED:github]}", "input": "{\"token\":[REDACTED:github]}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"token\":[REDACTED:github]}"},
    {"name": "known gap: {\"token\":\\n \"abc\"}", "input": "{\"token\":\n \"abc\"}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"token\":\n \"abc\"}"},
    {"name": "known gap: {\"password\":\\n \"x\"}", "input": "{\"password\":\n \"x\"}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"password\":\n \"x\"}"},
    {"name": "feedback: sessionid=x", "input": "sessionid=x", "mode": "strict", "opts": {"pii": true}, "expected": "sessionid=[REDACTED:secret]"},
    {"name": "feedback: session=x", "input": "session=x", "mode": "strict", "opts": {"pii": true}, "expected": "session=[REDACTED:secret]"},
    {"name": "feedback: sessionid: hunter2", "input": "sessionid: hunter2", "mode": "strict", "opts": {"pii": true}, "expected": "sessionid: [REDACTED:secret]"},
    {"name": "feedback: {\"sessionid\":\"hunter2\"}", "input": "{\"sessionid\":\"hunter2\"}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"sessionid\":\"[REDACTED:secret]\"}"},
    {"name": "feedback: session: abc&def", "input": "session: abc&def", "mode": "strict", "opts": {"pii": true}, "expected": "session: [REDACTED:secret]"},
    {"name": "feedback: X_SESSION: hunter2", "input": "X_SESSION: hunter2", "mode": "strict", "opts": {"pii": true}, "expected": "X_SESSION: [REDACTED:secret]"},
    {"name": "feedback: session: expired", "input": "session: expired", "mode": "strict", "opts": {"pii": true}, "expected": "session: expired"},
    {"name": "feedback: max_tokens: 5 requested, 3 available", "input": "max_tokens: 5 requested, 3 available", "mode": "strict", "opts": {"pii": true}, "expected": "max_tokens: 5 requested, 3 available"},
    {"name": "feedback: prompt_tokens: 120 used", "input": "prompt_tokens: 120 used", "mode": "strict", "opts": {"pii": true}, "expected": "prompt_tokens: 120 used"},
    {"name": "feedback: a closing brace inside a credential is not a delimiter", "input": "password=Zq93abc}stillsecret", "mode": "strict", "opts": {"pii": true}, "expected": "password=[REDACTED:generic-keyword]"},
    {"name": "feedback: a scheme argument can be quoted", "input": "token=Basic \"two words\"", "mode": "strict", "opts": {"pii": true}, "expected": "token=[REDACTED:secret]"},
    {"name": "known gap: client.auth='it''s hunter2'", "input": "client.auth='it''s hunter2'", "mode": "strict", "opts": {"pii": true}, "expected": "client.auth='[REDACTED:generic-keyword]''s hunter2'"},
    {"name": "known gap: {\"sessionid\":\\n \"hunter2\"}", "input": "{\"sessionid\":\n \"hunter2\"}", "mode": "strict", "opts": {"pii": true}, "expected": "{\"sessionid\":\n \"hunter2\"}"},
    {"name": "review: sessionid in query", "input": "https://a.test/?sessionid=hunter2&keep=1", "mode": "strict", "opts": {"pii": true}, "expected": "https://a.test/?sessionid=[REDACTED:secret]&keep=1"},
    {"name": "review: single quoted sessionid", "input": "sessionid='hunter2'", "mode": "strict", "opts": {"pii": true}, "expected": "sessionid='[REDACTED:secret]'"}
  ]
}
