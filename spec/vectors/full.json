{
  "description": "Full tier (the ported secretlint rules, SPEC 4.11 to 4.17): `expectedSync` is the standard tier, `expectedAsync` the full tier (`expected` when both agree). Each rule has a hit, near misses at its bounds and its letter guard; the scan cap and the scan windows are crossed with `inputGen`. An implementation without the full tier skips this file (`tier`).",
  "tier": "full",
  "cases": [
    {
      "name": "aws key id",
      "input": "creds: AKIAQR7ZKT4MW2PLX9BD",
      "expected": "creds: [REDACTED:aws]"
    },
    {
      "name": "aws key id of the AWS documentation is ignored",
      "input": "AKIAIOSFODNN7EXAMPLE",
      "expected": "[REDACTED:aws]"
    },
    {
      "name": "aws account id",
      "input": "\"aws_account_id\": \"1234-5678-9012\"",
      "expectedSync": "\"aws_account_id\": \"1234-5678-9012\"",
      "expectedAsync": "[REDACTED:aws]\""
    },
    {
      "name": "aws secret access key: the secret is redacted, the key name stays",
      "input": "AWS_SECRET_ACCESS_KEY = wJalrXUtnFEMI/K7MDENG/bPxRfiCYSECRETSKEY\n",
      "expectedSync": "AWS_SECRET_ACCESS_KEY = [REDACTED:generic-keyword]\n",
      "expectedAsync": "AWS_SECRET_ACCESS_KEY = [REDACTED:aws]\n"
    },
    {
      "name": "aws secret access key of the AWS documentation is ignored",
      "input": "aws_secret_access_key=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
      "expected": "aws_secret_access_key=[REDACTED:generic-keyword]"
    },
    {
      "name": "aws secret access key quoted",
      "input": "\"aws_secret_access_key\": \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYSECRETSKEY\"",
      "expectedSync": "\"aws_secret_access_key\": \"[REDACTED:generic-keyword]\"",
      "expectedAsync": "\"aws_secret_access_key\": \"[REDACTED:aws]\""
    },
    {
      "name": "private key",
      "input": "key:\n-----BEGIN PRIVATE KEY-----\nMIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n-----END PRIVATE KEY-----\ndone",
      "expectedSync": "key:\n[REDACTED:private-key]\ndone",
      "expectedAsync": "key:\n[REDACTED:privatekey]\ndone"
    },
    {
      "name": "private key with escaped newlines",
      "input": "{\"k\":\"-----BEGIN RSA PRIVATE KEY-----\\nMIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\\n-----END RSA PRIVATE KEY-----\"}",
      "expectedSync": "{\"k\":\"[REDACTED:private-key]\"}",
      "expectedAsync": "{\"k\":\"[REDACTED:privatekey]\"}"
    },
    {
      "name": "private key placeholder body is not a key",
      "input": "-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----",
      "expected": "[REDACTED:private-key]"
    },
    {
      "name": "private key body of 99 units is too short",
      "input": "-----BEGIN PRIVATE KEY-----\nMIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n-----END PRIVATE KEY-----",
      "expected": "[REDACTED:private-key]"
    },
    {
      "name": "private key without a footer is not a hit",
      "input": "-----BEGIN PRIVATE KEY-----\nMIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "[REDACTED:private-key]"
    },
    {
      "name": "private key openssh",
      "input": "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n-----END OPENSSH PRIVATE KEY-----",
      "expectedSync": "[REDACTED:private-key]",
      "expectedAsync": "[REDACTED:privatekey]"
    },
    {
      "name": "private key header inside the trailing dashes of another",
      "input": "-----BEGIN PRIVATE KEY-----BEGIN PRIVATE KEY-----\nMIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n-----END PRIVATE KEY-----",
      "expected": "[REDACTED:private-key]"
    },
    {
      "name": "npm token",
      "input": "registry token npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA done",
      "expectedSync": "registry token [REDACTED:auth-header] done",
      "expectedAsync": "registry token [REDACTED:npm] done"
    },
    {
      "name": "npm token 37 units",
      "input": "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    },
    {
      "name": "npm token behind a letter",
      "input": "xnpm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "xnpm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    },
    {
      "name": "npm token behind a non-letter digit",
      "input": "1npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expectedSync": "1npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expectedAsync": "1[REDACTED:npm]"
    },
    {
      "name": "npm token behind an astral letter",
      "input": "\ud835\udc00npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "\ud835\udc00npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    },
    {
      "name": "npm token behind an astral emoji",
      "input": "\ud83d\ude00npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expectedSync": "\ud83d\ude00npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expectedAsync": "\ud83d\ude00[REDACTED:npm]"
    },
    {
      "name": "npm token behind a lone surrogate",
      "input": "\ud800npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expectedSync": "\ud800npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expectedAsync": "\ud800[REDACTED:npm]"
    },
    {
      "name": "npm token behind a BMP letter",
      "input": "\u00e9npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "\u00e9npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    },
    {
      "name": "basic auth url",
      "input": "fetch https://alice:hunter2x@host.example.com/path now",
      "expectedSync": "fetch https://alice:[REDACTED:url-credentials]@host.example.com/path now",
      "expectedAsync": "fetch [REDACTED:basicauth]/path now"
    },
    {
      "name": "basic auth password is a placeholder",
      "input": "https://alice:password@host.example.com",
      "expected": "https://alice:[REDACTED:url-credentials]@host.example.com"
    },
    {
      "name": "basic auth password is one repeated character",
      "input": "https://alice:aaaa@host.example.com",
      "expected": "https://alice:[REDACTED:url-credentials]@host.example.com"
    },
    {
      "name": "basic auth user too short",
      "input": "https://a:hunter2x@host.example.com",
      "expected": "https://a:[REDACTED:url-credentials]@host.example.com"
    },
    {
