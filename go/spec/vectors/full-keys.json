{
  "description": "Object keys in the full tier (SPEC 8, 9.4): a key that is itself a secret of the full tier is replaced by its placeholder, in compat and strict. `expectedSync` is the standard tier, which does not know the full-tier formats (npm, 1password, ...); `expectedAsync` the full tier. Keys that collide after replacement keep every value (SPEC 8): the full-tier tokens collide like the standard ones. ",
  "tier": "full",
  "cases": [
    {
      "name": "a key that is an npm token",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1
      },
      "expectedAsync": {
        "[REDACTED:npm]": 1
      }
    },
    {
      "name": "a key that is a slack token",
      "input": {
        "xoxb-123456789012-123456789012-abcdefghijklmnopqrstuvwx": "v"
      },
      "expected": {
        "[REDACTED:slack]": "v"
      }
    },
    {
      "name": "a key that is a 1password token",
      "input": {
        "ops_eyJmYWtlIjoibm90LWEtcmVhbC1jcmVkZW50aWFsIiwicGFkZGluZyI6IkFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUEifQ==": "v"
      },
      "expectedSync": {
        "ops_eyJmYWtlIjoibm90LWEtcmVhbC1jcmVkZW50aWFsIiwicGFkZGluZyI6IkFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUEifQ==": "v"
      },
      "expectedAsync": {
        "[REDACTED:1password]": "v"
      }
    },
    {
      "name": "a key that is a github token",
      "input": {
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "v"
      },
      "expected": {
        "[REDACTED:github]": "v"
      }
    },
    {
      "name": "a key that is a database connection string",
      "input": {
        "postgres://admin:Zx9kQ7mPq@db.example.com:5432/app": "v"
      },
      "expectedSync": {
        "postgres://admin:[REDACTED:url-credentials]@db.example.com:5432/app": "v"
      },
      "expectedAsync": {
        "[REDACTED:database-connection-string]": "v"
      }
    },
    {
      "name": "a normal key is unchanged",
      "input": {
        "normal_key_name": "v",
        "name_npm_AAAAAA": "v"
      },
      "expected": {
        "normal_key_name": "v",
        "name_npm_AAAAAA": "v"
      }
    },
    {
      "name": "a key with a token inside it",
      "input": {
        "prefix npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA suffix": "v"
      },
      "expectedSync": {
        "prefix npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA suffix": "v"
      },
      "expectedAsync": {
        "prefix [REDACTED:npm] suffix": "v"
      }
    },
    {
      "name": "a key behind a letter is not a token",
      "input": {
        "xnpm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "v"
      },
      "expected": {
        "xnpm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "v"
      }
    },
    {
      "name": "nested keys and arrays",
      "input": {
        "list": [
          {
            "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1
          },
          {
            "ok": {
              "xoxb-123456789012-123456789012-abcdefghijklmnopqrstuvwx": [
                1,
                2
              ]
            }
          }
        ]
      },
      "expectedSync": {
        "list": [
          {
            "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1
          },
          {
            "ok": {
              "[REDACTED:slack]": [
                1,
                2
              ]
            }
          }
        ]
      },
      "expectedAsync": {
        "list": [
          {
            "[REDACTED:npm]": 1
          },
          {
            "ok": {
              "[REDACTED:slack]": [
                1,
                2
              ]
            }
          }
        ]
      }
    },
    {
      "name": "a token key and a plain value under it",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": {
          "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "v"
        }
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": {
          "[REDACTED:github]": "v"
        }
      },
      "expectedAsync": {
        "[REDACTED:npm]": {
          "[REDACTED:github]": "v"
        }
      }
    },
    {
      "name": "strict: a key that is an npm token",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "normal_key_name": "v"
      },
      "mode": "strict",
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "normal_key_name": "v"
      },
      "expectedAsync": {
        "[REDACTED:npm]": 1,
        "normal_key_name": "v"
      }
    },
    {
      "name": "strict: a key that is a 1password token",
      "input": {
        "ops_eyJmYWtlIjoibm90LWEtcmVhbC1jcmVkZW50aWFsIiwicGFkZGluZyI6IkFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUEifQ==": "v"
      },
      "mode": "strict",
      "expectedSync": {
        "ops_eyJmYWtlIjoibm90LWEtcmVhbC1jcmVkZW50aWFsIiwicGFkZGluZyI6IkFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUEifQ==": "v"
      },
      "expectedAsync": {
        "[REDACTED:1password]": "v"
      }
    },
    {
      "name": "strict: nested keys",
      "input": {
        "list": [
          {
            "xoxb-123456789012-123456789012-abcdefghijklmnopqrstuvwx": 1
          }
        ]
      },
      "mode": "strict",
      "expected": {
        "list": [
          {
            "[REDACTED:slack]": 1
          }
        ]
      }
    },
    {
      "name": "two tokens collide after replacement: the first keeps the plain key, the second gets #2",
      "input": {
        "first": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "a",
        "middle": 2,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": "b"
      },
      "expectedSync": {
        "first": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "a",
        "middle": 2,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": "b"
      },
      "expectedAsync": {
        "first": 1,
        "[REDACTED:npm]": "a",
        "middle": 2,
        "[REDACTED:npm#2]": "b"
      }
    },
    {
      "name": "three tokens collide: #2 and #3 in contract order",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 3
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 3
      },
      "expectedAsync": {
        "[REDACTED:npm]": 1,
        "[REDACTED:npm#2]": 2,
        "[REDACTED:npm#3]": 3
      }
    },
    {
      "name": "collisions are counted per placeholder key and per object",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 2,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3,
        "ghp_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": 4,
        "nested": {
          "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 5,
          "npm_DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD": 6
        }
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "[REDACTED:github]": 2,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3,
        "[REDACTED:github#2]": 4,
        "nested": {
          "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 5,
          "npm_DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD": 6
        }
      },
      "expectedAsync": {
        "[REDACTED:npm]": 1,
        "[REDACTED:github]": 2,
        "[REDACTED:npm#2]": 3,
        "[REDACTED:github#2]": 4,
        "nested": {
          "[REDACTED:npm]": 5,
          "[REDACTED:npm#2]": 6
        }
      }
    },
    {
      "name": "a key written as a placeholder keeps its own name, also when a token key comes first",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "[REDACTED:npm]": 2
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "[REDACTED:npm]": 2
      },
      "expectedAsync": {
        "[REDACTED:npm#2]": 1,
        "[REDACTED:npm]": 2
      }
    },
    {
      "name": "a key written as a numbered placeholder is reserved: the generated numbers skip it",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "[REDACTED:npm#2]": 3
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "[REDACTED:npm#2]": 3
      },
      "expectedAsync": {
        "[REDACTED:npm]": 1,
        "[REDACTED:npm#3]": 2,
        "[REDACTED:npm#2]": 3
      }
    },
    {
      "name": "a key that holds a token gets the number inside its last placeholder",
      "input": {
        "token npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "token npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2
      },
      "expectedSync": {
        "token [REDACTED:auth-header]": "[REDACTED:key-context]",
        "token [REDACTED:auth-header#2]": "[REDACTED:key-context]"
      },
      "expectedAsync": {
        "token [REDACTED:npm]": "[REDACTED:key-context]",
        "token [REDACTED:npm#2]": "[REDACTED:key-context]"
      }
    },
    {
      "name": "strict: two tokens collide after replacement",
      "input": {
        "first": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "a",
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": "b"
      },
      "mode": "strict",
      "expectedSync": {
        "first": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "a",
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": "b"
      },
      "expectedAsync": {
        "first": 1,
        "[REDACTED:npm]": "a",
        "[REDACTED:npm#2]": "b"
      }
    },
    {
      "name": "strict: a key written as a placeholder keeps its own name",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "[REDACTED:npm]": 2
      },
      "mode": "strict",
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "[REDACTED:npm]": 2
      },
      "expectedAsync": {
        "[REDACTED:npm#2]": 1,
        "[REDACTED:npm]": 2
      }
    },
    {
      "name": "strict: a key that holds a token gets the number inside its last placeholder",
      "input": {
        "token npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "token npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2
      },
      "mode": "strict",
      "expectedSync": {
        "token [REDACTED:auth-header]": "[REDACTED:key-context]",
        "token [REDACTED:auth-header#2]": "[REDACTED:key-context]"
      },
      "expectedAsync": {
        "token [REDACTED:npm]": "[REDACTED:key-context]",
        "token [REDACTED:npm#2]": "[REDACTED:key-context]"
      }
    },
    {
      "name": "two database connection strings keep both values",
      "input": {
        "postgres://user:Zq9abcDEF123ghi_x@db.example.test:5432/app": "first",
        "postgres://other:Qw8rtyUIO456jkl_z@db2.example.test:5432/app": "second"
      },
      "expectedSync": {
        "postgres://user:[REDACTED:url-credentials]@db.example.test:5432/app": "first",
        "postgres://other:[REDACTED:url-credentials]@db2.example.test:5432/app": "second"
      },
      "expectedAsync": {
        "[REDACTED:database-connection-string]": "first",
        "[REDACTED:database-connection-string#2]": "second"
      }
    },
    {
      "name": "colliding keys are numbered per placeholder name in iteration order",
      "input": {
        "postgres://user:Zq9abcDEF123ghi_x@db.example.test:5432/app": 1,
        "x": 2,
        "postgres://other:Qw8rtyUIO456jkl_z@db2.example.test:5432/app": 3,
        "mongodb://third:Mn7opqRST890uvw_y@db3.example.test/app": 4,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 5,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 6
      },
      "expectedSync": {
        "postgres://user:[REDACTED:url-credentials]@db.example.test:5432/app": 1,
        "x": 2,
        "postgres://other:[REDACTED:url-credentials]@db2.example.test:5432/app": 3,
        "mongodb://third:[REDACTED:url-credentials]@db3.example.test/app": 4,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 5,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 6
      },
      "expectedAsync": {
        "[REDACTED:database-connection-string]": 1,
        "x": 2,
        "[REDACTED:database-connection-string#2]": 3,
        "[REDACTED:database-connection-string#3]": 4,
        "[REDACTED:npm]": 5,
        "[REDACTED:npm#2]": 6
      }
    },
    {
      "name": "numbering skips the names of unchanged keys",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "[REDACTED:npm#2]": 3,
        "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 4,
        "[REDACTED:npm]": 5
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "[REDACTED:npm#2]": 3,
        "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 4,
        "[REDACTED:npm]": 5
      },
      "expectedAsync": {
        "[REDACTED:npm#3]": 1,
        "[REDACTED:npm#4]": 2,
        "[REDACTED:npm#2]": 3,
        "[REDACTED:npm#5]": 4,
        "[REDACTED:npm]": 5
      }
    },
    {
      "name": "a key with a placeholder inside gets the number in its last placeholder",
      "input": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA then npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB then npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 4
      },
      "expectedSync": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA then npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB then npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 4
      },
      "expectedAsync": {
        "label [REDACTED:npm]": 1,
        "label [REDACTED:npm#2]": 2,
        "[REDACTED:npm] then [REDACTED:npm]": 3,
        "[REDACTED:npm] then [REDACTED:npm#2]": 4
      }
    },
    {
      "name": "an unnumbered placeholder before a suffixed one is numbered at the last placeholder",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA [REDACTED:foo:bar] npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB [REDACTED:foo:bar] npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA [REDACTED:foo:bar] npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB [REDACTED:foo:bar] npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2
      },
      "expectedAsync": {
        "[REDACTED:npm] [REDACTED:foo:bar] [REDACTED:npm]": 1,
        "[REDACTED:npm] [REDACTED:foo:bar] [REDACTED:npm#2]": 2
      }
    },
    {
      "name": "strict: two database connection strings keep both values",
      "input": {
        "postgres://user:Zq9abcDEF123ghi_x@db.example.test:5432/app": "first",
        "postgres://other:Qw8rtyUIO456jkl_z@db2.example.test:5432/app": "second"
      },
      "mode": "strict",
      "expectedSync": {
        "postgres://user:[REDACTED:url-credentials]@db.example.test:5432/app": "first",
        "postgres://other:[REDACTED:url-credentials]@db2.example.test:5432/app": "second"
      },
      "expectedAsync": {
        "[REDACTED:database-connection-string]": "first",
        "[REDACTED:database-connection-string#2]": "second"
      }
    },
    {
      "name": "strict: colliding keys are numbered per placeholder name in iteration order",
      "input": {
        "postgres://user:Zq9abcDEF123ghi_x@db.example.test:5432/app": 1,
        "x": 2,
        "postgres://other:Qw8rtyUIO456jkl_z@db2.example.test:5432/app": 3,
        "mongodb://third:Mn7opqRST890uvw_y@db3.example.test/app": 4,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 5,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 6
      },
      "mode": "strict",
      "expectedSync": {
        "postgres://user:[REDACTED:url-credentials]@db.example.test:5432/app": 1,
        "x": 2,
        "postgres://other:[REDACTED:url-credentials]@db2.example.test:5432/app": 3,
        "mongodb://third:[REDACTED:url-credentials]@db3.example.test/app": 4,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 5,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 6
      },
      "expectedAsync": {
        "[REDACTED:database-connection-string]": 1,
        "x": 2,
        "[REDACTED:database-connection-string#2]": 3,
        "[REDACTED:database-connection-string#3]": 4,
        "[REDACTED:npm]": 5,
        "[REDACTED:npm#2]": 6
      }
    },
    {
      "name": "strict: numbering skips the names of unchanged keys",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "[REDACTED:npm#2]": 3,
        "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 4,
        "[REDACTED:npm]": 5
      },
      "mode": "strict",
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "[REDACTED:npm#2]": 3,
        "npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC": 4,
        "[REDACTED:npm]": 5
      },
      "expectedAsync": {
        "[REDACTED:npm#3]": 1,
        "[REDACTED:npm#4]": 2,
        "[REDACTED:npm#2]": 3,
        "[REDACTED:npm#5]": 4,
        "[REDACTED:npm]": 5
      }
    },
    {
      "name": "strict: a key with a placeholder inside gets the number in its last placeholder",
      "input": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA then npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB then npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 4
      },
      "mode": "strict",
      "expectedSync": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA then npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB then npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 4
      },
      "expectedAsync": {
        "label [REDACTED:npm]": 1,
        "label [REDACTED:npm#2]": 2,
        "[REDACTED:npm] then [REDACTED:npm]": 3,
        "[REDACTED:npm] then [REDACTED:npm#2]": 4
      }
    },
    {
      "name": "strict: an unnumbered placeholder before a suffixed one is numbered at the last placeholder",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA [REDACTED:foo:bar] npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB [REDACTED:foo:bar] npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2
      },
      "mode": "strict",
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA [REDACTED:foo:bar] npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB [REDACTED:foo:bar] npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 2
      },
      "expectedAsync": {
        "[REDACTED:npm] [REDACTED:foo:bar] [REDACTED:npm]": 1,
        "[REDACTED:npm] [REDACTED:foo:bar] [REDACTED:npm#2]": 2
      }
    },
    {
      "name": "a number under a secret key and a key-context collision keep every value",
      "input": {
        "a": {
          "postgres://user:Zq9abcDEF123ghi_x@db.example.test:5432/app": {
            "pin": 1
          },
          "postgres://other:Qw8rtyUIO456jkl_z@db2.example.test:5432/app": {
            "pin": 2
          }
        }
      },
      "expectedSync": {
        "a": {
          "postgres://user:[REDACTED:url-credentials]@db.example.test:5432/app": {
            "pin": "[REDACTED:key-context]"
          },
          "postgres://other:[REDACTED:url-credentials]@db2.example.test:5432/app": {
            "pin": "[REDACTED:key-context]"
          }
        }
      },
      "expectedAsync": {
        "a": {
          "[REDACTED:database-connection-string]": {
            "pin": "[REDACTED:key-context]"
          },
          "[REDACTED:database-connection-string#2]": {
            "pin": "[REDACTED:key-context]"
          }
        }
      }
    },
    {
      "name": "a key with a placeholder inside that is unchanged is reserved",
      "input": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label [REDACTED:npm]": 2
      },
      "expectedSync": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label [REDACTED:npm]": 2
      },
      "expectedAsync": {
        "label [REDACTED:npm#2]": 1,
        "label [REDACTED:npm]": 2
      }
    },
    {
      "name": "strict: a key inside the budget is reserved and the size-limit keys are numbered round it",
      "input": {
        "a": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "[REDACTED:npm]": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 2
      },
      "mode": "strict",
      "opts": {
        "maxChars": 40
      },
      "expected": {
        "a": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "[REDACTED:size-limit]": 1,
        "[REDACTED:size-limit#2]": 2
      }
    },
    {
      "name": "strict: placeholder keys over a small budget are numbered after the size-limit marker",
      "input": {
        "[REDACTED:npm]": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 2,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3
      },
      "mode": "strict",
      "opts": {
        "maxChars": 20
      },
      "expected": {
        "[REDACTED:npm]": 1,
        "[REDACTED:size-limit]": 2,
        "[REDACTED:size-limit#2]": 3
      }
    },
    {
      "name": "strict: a size-limit key equal to an input key is still a changed key",
      "input": {
        "[REDACTED:size-limit]": 1,
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 2,
        "npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB": 3
      },
      "mode": "strict",
      "opts": {
        "maxChars": 30
      },
      "expected": {
        "[REDACTED:size-limit]": 1,
        "[REDACTED:size-limit#2]": 2,
        "[REDACTED:size-limit#3]": 3
      }
    },
    {
      "name": "node limit: strict numbers the marker key",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "keep",
        "[REDACTED:npm]": 2,
        "c": 3
      },
      "mode": "strict",
      "opts": {
        "maxNodes": 2
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "keep",
        "[REDACTED:size-limit]": "[REDACTED:size-limit]"
      },
      "expectedAsync": {
        "[REDACTED:npm#2]": "keep",
        "[REDACTED:size-limit]": "[REDACTED:size-limit]"
      }
    },
    {
      "name": "a key that holds two tokens gets the number in the last one",
      "input": {
        "x npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA y npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB z": 1,
        "x npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC y npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA z": 2
      },
      "expectedSync": {
        "x npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA y npm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB z": 1,
        "x npm_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC y npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA z": 2
      },
      "expectedAsync": {
        "x [REDACTED:npm] y [REDACTED:npm] z": 1,
        "x [REDACTED:npm] y [REDACTED:npm#2] z": 2
      }
    },
    {
      "name": "strict: a number under a secret key and a key-context collision keep every value",
      "input": {
        "a": {
          "postgres://user:Zq9abcDEF123ghi_x@db.example.test:5432/app": {
            "pin": 1
          },
          "postgres://other:Qw8rtyUIO456jkl_z@db2.example.test:5432/app": {
            "pin": 2
          }
        }
      },
      "mode": "strict",
      "expectedSync": {
        "a": {
          "postgres://user:[REDACTED:url-credentials]@db.example.test:5432/app": {
            "pin": "[REDACTED:key-context]"
          },
          "postgres://other:[REDACTED:url-credentials]@db2.example.test:5432/app": {
            "pin": "[REDACTED:key-context]"
          }
        }
      },
      "expectedAsync": {
        "a": {
          "[REDACTED:database-connection-string]": {
            "pin": "[REDACTED:key-context]"
          },
          "[REDACTED:database-connection-string#2]": {
            "pin": "[REDACTED:key-context]"
          }
        }
      }
    },
    {
      "name": "strict: a key with a placeholder inside that is unchanged is reserved",
      "input": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label [REDACTED:npm]": 2
      },
      "mode": "strict",
      "expectedSync": {
        "label npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 1,
        "label [REDACTED:npm]": 2
      },
      "expectedAsync": {
        "label [REDACTED:npm#2]": 1,
        "label [REDACTED:npm]": 2
      }
    },
    {
      "name": "node limit: a reserved key that the budget replaces keeps its name reserved (strict, 40 chars)",
      "input": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 2,
