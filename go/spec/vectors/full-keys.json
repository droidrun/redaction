        "more": 4
      },
      "mode": "strict",
      "opts": {
        "maxChars": 40
      },
      "expectedSync": {
        "npm_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": 2,
        "[REDACTED:size-limit]": 1,
        "[REDACTED:size-limit#2]": 3,
        "[REDACTED:size-limit#3]": 4
      },
      "expectedAsync": {
        "[REDACTED:npm]": 2,
        "[REDACTED:size-limit]": 1,
        "[REDACTED:size-limit#2]": 3,
        "[REDACTED:size-limit#3]": 4
      }
    }
