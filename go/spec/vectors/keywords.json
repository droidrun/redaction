{
  "description": "credential keywords followed by a value, in free text",
  "cases": [
    {
      "name": "bare password pair",
      "input": "password: hunter2",
      "expected": "password: [REDACTED:generic-keyword]"
    },
    {
      "name": "password with mixed value",
      "input": "login: admin password: S0mmer2026!xTr0ub4dor",
      "expected": "login: admin password: [REDACTED:generic-keyword]"
    },
    {
      "name": "equals form, trailing comma kept",
      "input": "api_key=sk-live-1,next=2",
      "expected": "api_key=[REDACTED:generic-keyword],next=2"
    },
    {
      "name": "quoted value with spaces",
      "input": "password=\"my secret phrase\" next",
      "expected": "password=\"[REDACTED:generic-keyword]\" next"
    },
    {
      "name": "single quoted value",
      "input": "password='my secret phrase' next",
      "expected": "password='[REDACTED:generic-keyword]' next"
    },
    {
      "name": "escaped quote inside value",
      "input": "password=\"she said \\\"hi there\\\" ok\" tail",
      "expected": "password=\"[REDACTED:generic-keyword]\" tail"
    },
    {
      "name": "unterminated quote",
      "input": "password=\"truncated-by-cut",
      "expected": "password=\"[REDACTED:generic-keyword]"
    },
    {
      "name": "json object text",
      "input": "{\"api_key\": \"has space, and comma\"}",
      "expected": "{\"api_key\": \"[REDACTED:generic-keyword]\"}"
    },
    {
      "name": "json object text with client_secret",
      "input": "{\"client_secret\":\"Zk9-fakeMARKER_7q2x\",\"ok\":true}",
      "expected": "{\"client_secret\":\"[REDACTED:generic-keyword]\",\"ok\":true}"
    },
    {
      "name": "prefixed identifier",
      "input": "session_token: Zk9-fakeMARKER_7q2x",
      "expected": "session_token: [REDACTED:generic-keyword]"
    },
    {
      "name": "two pairs in one line",
      "input": "user=bob password=hunter2 token=Zk9-fakeMARKER_7q2x",
      "expected": "user=bob password=[REDACTED:generic-keyword] token=[REDACTED:generic-keyword]"
    },
    {
      "name": "aws secret access key",
      "input": "AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMIK7MDENGbPxRfiCYzzzzKEY9xxx1",
      "expectedSync": "AWS_SECRET_ACCESS_KEY=[REDACTED:generic-keyword]",
      "expectedAsync": "AWS_SECRET_ACCESS_KEY=[REDACTED:aws]"
    },
    {
      "name": "already a placeholder (idempotent)",
      "input": "password: [REDACTED:generic-keyword]",
      "expected": "password: [REDACTED:generic-keyword]"
    },
    {
      "name": "legacy bare placeholder stays",
      "input": "password: [REDACTED]",
      "expected": "password: [REDACTED]"
    },
    {
      "name": "legacy last4 placeholder stays",
      "input": "password: [REDACTED:generic-keyword:4dor]",
      "expected": "password: [REDACTED:generic-keyword:4dor]"
    },
    {
      "name": "escaped json, one layer",
      "input": "{\\\"password\\\":\\\"hunter2abc\\\",\\\"ok\\\":1}",
      "expected": "{\\\"password\\\":\\\"[REDACTED:generic-keyword]\\\",\\\"ok\\\":1}"
    },
    {
      "name": "escaped json, two layers",
      "input": "{\\\\\\\"password\\\\\\\":\\\\\\\"hunter2abc\\\\\\\",\\\\\\\"ok\\\\\\\":1}",
      "expected": "{\\\\\\\"password\\\\\\\":\\\\\\\"[REDACTED:generic-keyword]\\\\\\\",\\\\\\\"ok\\\\\\\":1}"
    },
    {
      "name": "escaped json with spaces in the value",
      "input": "{\\\"api_key\\\":\\\"has space, here\\\",\\\"ok\\\":1}",
      "expected": "{\\\"api_key\\\":\\\"[REDACTED:generic-keyword]\\\",\\\"ok\\\":1}"
    },
    {
      "name": "secret longer than the capture window",
      "input": "password=Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1!Ab1! tail",
      "expected": "password=[REDACTED:generic-keyword] tail"
    },
    {
      "name": "label inside a rejected value",
      "input": "password : session_token: Zq9fakeSECRET_8x",
      "expected": "password : [REDACTED:generic-keyword] [REDACTED:generic-keyword]"
    },
    {
      "name": "placeholder with a space in last4 stays",
      "input": "password: [REDACTED:generic-keyword:ab cd]",
      "expected": "password: [REDACTED:generic-keyword:ab cd]"
    },
    {
      "name": "value that merely starts like a placeholder",
      "input": "password=[REDACTED]tail1234",
      "expected": "password=[REDACTED:generic-keyword]"
    }
  ]
}
